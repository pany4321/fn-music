.detail

# Android Studio and local SDK configuration
.idea/
*.iml
local.properties
captures/

# Gradle and Kotlin build state
.gradle/
.kotlin/
**/build/

# Native build intermediates
**/.cxx/
**/.externalNativeBuild/

# Signing material must stay local
*.jks
*.keystore
keystore.properties

# Local API research notes
docs/API.md

# Operating system metadata
.DS_Store
Thumbs.db

# Cloudflare publisher tool and deployment state stay local
**/node_modules/
tool/update-publisher/
SearchPlaybackDiagnosticTest.kt
.trellis/tasks/

# Local scratch (screenshots, adb dumps) never gets committed
.trellis/tmp/

# 本地测试凭据（NAS / Jellyfin 的账号密码、抓包结果等）绝不入库
.trellis/local/

# 会话/计划草稿：里面会写测试服务器地址，不进仓库
.zcode/
